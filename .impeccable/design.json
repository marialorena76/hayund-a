    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single terracotta action of a view: Continuar, Unirme por Zoom, Ver.",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M7 4.5v15l13-7.5Z\"/></svg>Continuar</button>",
      "css": ".ds-btn-primary{appearance:none;border:0;cursor:pointer;display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:12px 24px;border-radius:999px;font:700 16px/1 Karla,'Segoe UI',system-ui,sans-serif;background:#C9502A;color:#fff;transition:background .2s}.ds-btn-primary:hover{background:#A8401F}.ds-btn-primary:focus-visible{outline:3px solid #ED9615;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions: Volver a ver, Ir a Ave Mujer, anterior/siguiente.",
      "html": "<button class=\"ds-btn-ghost\">Volver a ver</button>",
      "css": ".ds-btn-ghost{appearance:none;border:0;cursor:pointer;display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:10px 18px;border-radius:999px;font:700 15px/1 Karla,'Segoe UI',system-ui,sans-serif;background:transparent;color:#1A3A4C;box-shadow:inset 0 0 0 1.5px #EBDCD2;transition:background .2s}.ds-btn-ghost:hover{background:#F3E4DA}.ds-btn-ghost:focus-visible{outline:3px solid #ED9615;outline-offset:2px}"
    },
    {
